NODE_ENV=production
PORT=4000

MONGO_DATABASE=qr_feedback

BACKEND_URL=https://api.bugreveal.com
FRONTEND_URL=https://bugreveal.com
CORS_ORIGINS=https://bugreveal.com,https://www.bugreveal.com
JWT_SECRET=change-me-with-a-long-random-secret

FREE_EMAIL_NOTIFICATIONS=300
OTP_REQUEST_LIMIT=3
RATE_LIMIT_TIME_ZONE=Africa/Lagos
WEEKLY_RECOMMENDATION_LIMIT=7
OPENAI_API_KEY=
OPENAI_RECOMMENDATIONS_MODEL=gpt-4.1-mini
OPENAI_RECOMMENDATIONS_LANGUAGE=francais

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QR Feedback <no-reply@example.com>"

TURNSTILE_SECRET_KEY=

TYPESENSE_API_KEY=change-me-with-a-long-random-typesense-key
TYPESENSE_EMBEDDING_MODEL=ts/all-MiniLM-L12-v2
TYPESENSE_VECTOR_DISTANCE_THRESHOLD=0.45

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=QrFeedback_Bot
TELEGRAM_WEBHOOK_URL=https://api.bugreveal.com/api/webhooks/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=https://bugreveal.com
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600

ENCRYPTION_MASTER_KEY=generate-with-npm-run-generate-encryption-key

FASTERMESSAGE_API_KEY=
FASTERMESSAGE_BASE_URL=https://api.fastermessage.com
FASTERMESSAGE_SENDER_ID=QrFeedback
