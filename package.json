{
  "name": "qr-feedback-backend",
  "version": "1.0.0",
  "description": "Backend Express pour une plateforme de feedback client par QR code.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "type-check": "tsc --noEmit",
    "generate:encryption-key": "tsx src/scripts/generate-encryption-key.ts",
    "secret:set": "tsx src/scripts/set-secret.ts",
    "secret:set:prod": "node dist/scripts/set-secret.js",
    "secret:list": "tsx src/scripts/list-secrets.ts",
    "secret:list:prod": "node dist/scripts/list-secrets.js",
    "cleanup:feedback-legacy": "tsx src/scripts/cleanup-feedback-legacy-fields.ts",
    "migrate:email-free-quota": "tsx src/scripts/migrate-email-free-quota.ts",
    "migrate:reviews-moderation-status": "tsx src/scripts/migrate-reviews-moderation-status.ts",
    "seed:ai-reviews": "tsx src/scripts/seed-ai-analysis-reviews.ts",
    "seed:notification-templates": "tsx src/scripts/seed-notification-templates.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "telegram:setup": "tsx src/scripts/setup-telegram-bot.ts"
  },
  "dependencies": {
    "@json2csv/plainjs": "^7.0.6",
    "@types/pug": "^2.0.10",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.10",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^1.1.0",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.16.0",
    "pug": "^3.0.4",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
