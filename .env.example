NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
MONGO_URI=mongodb://mongo:27017/qr_feedback
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-with-a-long-random-secret
FREE_EMAIL_NOTIFICATIONS=300
OTP_REQUEST_LIMIT=3
REDIS_URL=redis://localhost:6379
RATE_LIMIT_TIME_ZONE=Africa/Lagos
WEEKLY_RECOMMENDATION_LIMIT=7
OPENAI_RECOMMENDATIONS_MODEL=gpt-4.1-mini
OPENAI_RECOMMENDATIONS_LANGUAGE=français

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=admin
SMTP_PASS=pass
MAIL_FROM="Opinbase <no-reply@example.com>"

TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=change-me-typesense-key
TYPESENSE_EMBEDDING_MODEL=ts/all-MiniLM-L12-v2
TYPESENSE_VECTOR_DISTANCE_THRESHOLD=0.45

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Opinbasebot
TELEGRAM_WEBHOOK_URL=
# Required when TELEGRAM_WEBHOOK_URL is set in production — generated by `npm run telegram:setup`.
# Without it, the webhook endpoint accepts unauthenticated requests from anyone.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_URL=
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600

ENCRYPTION_MASTER_KEY=generate-with-npm-run-generate-encryption-key

# FasterMessage SMS — clé secrète, ne jamais committer
FASTERMESSAGE_API_KEY=your-fastermessage-api-key
FASTERMESSAGE_BASE_URL=https://api.fastermessage.com
FASTERMESSAGE_SENDER_ID=Opinbase
