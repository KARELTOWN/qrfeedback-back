NODE_ENV=development
PORT=4000
BACKEND_URL=http://localhost:4000
MONGO_URI=mongodb://mongo:27017/qr_feedback
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-with-a-long-random-secret
FREE_WHATSAPP_MESSAGES=20

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=admin
SMTP_PASS=pass
MAIL_FROM="QR Feedback <no-reply@example.com>"

WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com
WHATSAPP_CLOUD_API_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-for-meta-webhook-verification
WHATSAPP_REVIEW_TEMPLATE_NAME=
WHATSAPP_REVIEW_TEMPLATE_LANGUAGE_CODE=fr

MONERO_WALLET_ADDRESS=
MONERO_NETWORK=mainnet
MONEROO_API_URL=https://api.moneroo.io
MONEROO_CURRENCY=XOF
# Prefer encrypted storage via PUT /api/secrets/monerooApiKey. This env var is only a fallback.
MONEROO_SECRET_KEY=

TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

PAYMENT_CONFIRM_SECRET=change-me-for-admin-confirmation
ENCRYPTION_MASTER_KEY=generate-with-npm-run-generate-encryption-key
